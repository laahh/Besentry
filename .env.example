DEBUG=True
SECRET_KEY=ganti-dengan-string-acak-panjang
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://besentry:besentry_dev@localhost:5433/besentry
REDIS_URL=redis://localhost:6379/0
# Riwayat perubahan (django-simple-history) disimpan di database terpisah
LOG_DATABASE_URL=postgis://besentry:besentry_dev@localhost:5433/besentry_log
# Kunci enkripsi password CCTV. Buat dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Backup kunci ini: tanpa kunci, password yang tersimpan tidak bisa dibaca lagi.
FIELD_ENCRYPTION_KEY=ganti-dengan-kunci-fernet

# Login BEATS + data karyawan SID (HSE Automation). Minta API key ke tim HSE Automation.
SID_API_KEY=ganti-dengan-api-key-sid
# BEATS_OFFLINE_FALLBACK=True   # izinkan login dengan password terakhir saat BEATS tidak bisa diakses

# Notifikasi ke PIC SGI: WhatsApp (Fonnte) + email (SMTP)
FONNTE_TOKEN=ganti-dengan-token-fonnte
MAIL_BACKUP_HOST=smtp.gmail.com
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=akun@gmail.com
MAIL_BACKUP_PASSWORD="app password gmail"
MAIL_BACKUP_ENCRYPTION=tls
MAIL_BACKUP_FROM_ADDRESS=akun@gmail.com
MAIL_BACKUP_FROM_NAME="BeSentry"
SITE_URL=http://127.0.0.1:8000
# NOTIFIKASI_ASYNC=True   # produksi: kirim lewat worker (service "notifier")

# Orthophoto / TiTiler (opsional, default cocok untuk docker compose lokal)
# TITILER_PUBLIC_URL=http://localhost:8081
# ORTHOPHOTO_GDAL_THREADS=ALL_CPUS
# ORTHOPHOTO_GDAL_CACHEMAX_MB=2048

# Port di komputer ini untuk docker compose (ubah kalau sudah dipakai program lain)
# WEB_PORT=8000
# TITILER_PORT=8081
# DB_PORT=5433      # kalau diubah, sesuaikan juga port di DATABASE_URL di atas
# REDIS_PORT=6379   # kalau diubah, sesuaikan juga port di REDIS_URL di atas
